      "script": "scripts/build-snapshot.js",
      "refresh": "weekly",
      "method": "Each weekly snapshot's stage per development, kept; a change of the rules is a re-read (marked rules), not a change on the ground.",
      "from": [
        "snapshot.json"
      ]
    },
    "servicing-permits.json": {
      "title": "Site servicing permits (water, sewer, storm)",
