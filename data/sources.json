    "snapshot.json": {
      "title": "Planning applications and building permits",
      "kind": "open-data",
      "publisher": "City of Mississauga, City of Brampton, Town of Caledon",
      "links": [],
      "itemLinks": "Each record links to its own feature in its layer (Record ↗ on the record; source_url in the exports). The layers are listed from snapshot.json › sources, so Mississauga’s monthly layer is always the one read.",
      "dateField": "generatedAt",
      "script": "scripts/build-snapshot.js",
      "refresh": "weekly",
      "linksFrom": "sources"
    },
